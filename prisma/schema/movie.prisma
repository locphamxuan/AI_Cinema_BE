enum MovieStatus {
  DRAFT
  ASSIGNED
  IN_PRODUCTION
  COMPLETED
  /// BR-56: a completed movie with episodes taken down to be fixed
  UNDER_REVISION
  CANCELLED
}

/// One movie project = one catalog movie (§4.1.1, §4.1.2). It is listed once an episode is
/// PUBLISHED. The production fee is not stored here: it is the sum of token_ledger (BR-46).
model Movie {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(255)
  ideaDescription String      @map("idea_description") @db.Text
  synopsis        String?     @db.Text
  defaultLanguage String      @default("vi") @map("default_language") @db.VarChar(10)
  /// BR-54: T16 or T18
  ageRating       String?     @map("age_rating") @db.VarChar(10)
  releaseYear     Int?        @map("release_year")
  /// Coin price of unlocking every episode of this movie at once; null = not sold as a bundle.
  status          MovieStatus @default(DRAFT)
  aiGenerated     Boolean     @default(true) @map("ai_generated")
  posterUrl       String?     @map("poster_url") @db.VarChar(500)
  bannerUrl       String?     @map("banner_url") @db.VarChar(500)
  trailerUrl      String?     @map("trailer_url") @db.VarChar(500)
  reviewerId      String      @map("reviewer_id") @db.Uuid
  creatorId       String?     @map("creator_id") @db.Uuid
  /// The one studio of the project (BR-59); it has no account (BR-15).
  studioId        String?     @map("studio_id") @db.Uuid
  cancelReason    String?     @map("cancel_reason") @db.Text
  handedOffAt     DateTime?   @map("handed_off_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviewer       User                   @relation("MovieReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  creator        User?                  @relation("MovieCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  studio         Studio?                @relation(fields: [studioId], references: [id], onDelete: Restrict)
  creatorAssignments ProjectCreatorAssignment[]
  genres         MovieGenre[]
  ideaFiles      MovieIdeaFile[]
  studioHandoffs StudioHandoff[]
  seasons        Season[]
  episodes       Episode[]
  tokenEntries   TokenLedgerEntry[]
  changeRequests ProjectChangeRequest[]
  auditLogs      AuditLog[]

  @@index([status])
  @@index([reviewerId])
  @@index([creatorId])
  @@index([studioId])
  @@map("movies")
}
