/// What the catalog shows of a movie; its `movie_projects` row shares the id (1:1). It is listed once an
/// episode is PUBLISHED; its seasons and episodes are the content viewers watch (BR-37).
model Movie {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(255)
  synopsis         String?  @db.Text
  defaultLanguage  String   @default("vi") @map("default_language") @db.VarChar(10)
  /// BR-54: T16 or T18
  ageRating        String?  @map("age_rating") @db.VarChar(10)
  releaseYear      Int?     @map("release_year")
  /// Free episodes of this movie, set by the Reviewer; null = the platform's free_starter_episode_count (BR-03).
  freeEpisodeCount Int?     @map("free_episode_count")
  aiGenerated      Boolean  @default(true) @map("ai_generated")
  posterUrl        String?  @map("poster_url") @db.VarChar(500)
  bannerUrl        String?  @map("banner_url") @db.VarChar(500)
  trailerUrl       String?  @map("trailer_url") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  MovieProject?
  genres   MovieGenre[]
  seasons  Season[]
  episodes Episode[]
  likes    MovieLike[]
  savedBy  SavedMovie[]

  @@map("movies")
}
