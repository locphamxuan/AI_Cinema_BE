//Sign up with a third-party AI provider (OpenAI, ElevenLabs, etc.)
model AiProvider {
    id       String  @id @default(uuid()) @db.Uuid
    name     String  @unique @db.VarChar(100)
    isActive Boolean @default(true) @map("is_active")
    config   Json?   @db.JsonB

    models AiModel[]

    @@map("ai_providers")
}
