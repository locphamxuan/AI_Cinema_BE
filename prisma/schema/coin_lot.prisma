/// Where a batch of bonus Coins came from.
enum CoinLotSource {
  /// A promotion an Admin set up on a top-up; a plain top-up credits main Coins only.
  TOP_UP_PROMO
  SIGNUP_BONUS
  DAILY_REWARD
  REWARD_SPIN
  REFUND
  ADJUSTMENT
}

/// One batch of bonus Coins and where it came from. Since 18/11/2026 bonus Coins never expire: they are
/// spent batch by batch, the oldest first; main Coins have no batch, so spending them needs no
/// bookkeeping. A batch is closed when its last Coin was spent or written off.
model CoinLot {
  id              String        @id @default(uuid()) @db.Uuid
  walletId        String        @map("wallet_id") @db.Uuid
  source          CoinLotSource
  originalAmount  Int           @map("original_amount")
  remainingAmount Int           @map("remaining_amount")
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)
  closedAt        DateTime?     @map("closed_at") @db.Timestamptz(6)

  wallet  CoinWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  entries CoinTransaction[] @relation("CoinLotSpentBy")

  @@index([walletId, grantedAt])
  @@map("coin_lots")
}
