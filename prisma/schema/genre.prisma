model Genre {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @unique @db.VarChar(100)
    description String? @db.Text

    movies                  MovieGenre[]
    productionProjectGenres ProductionProjectGenre[]
    styleModels             GenreStyleModel[]
    primaryForProjects      ProductionProject[]      @relation("ProductionProjectPrimaryGenre")

    @@map("genres")
}
