enum GenerationJobType {
    SCRIPT
    VOICE
    BACKGROUND_AUDIO
    SUBTITLE
    TRANSLATION
    POSTER
    THUMBNAIL
    VIDEO_ASSEMBLY
}

enum GenerationJobStatus {
    PENDING
    QUEUED
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
}

model GenerationJob {
    id                   String              @id @default(uuid()) @db.Uuid
    episodeId            String              @map("episode_id") @db.Uuid
    aiModelId            String              @map("ai_model_id") @db.Uuid
    jobType              GenerationJobType   @map("job_type")
    attemptNumber        Int                 @default(1) @map("attempt_number") @db.Integer
    parentJobId          String?             @map("parent_job_id") @db.Uuid
    configSnapshot       Json?               @map("config_snapshot") @db.JsonB
    status               GenerationJobStatus @default(PENDING)
    externalJobReference String?             @map("external_job_reference") @db.VarChar(255)
    errorMessage         String?             @map("error_message") @db.Text
    queuedAt             DateTime?           @map("queued_at") @db.Timestamptz(6)
    completedAt          DateTime?           @map("completed_at") @db.Timestamptz(6)
    createdById          String              @map("created_by_id") @db.Uuid
    createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

    episode   Episode         @relation(fields: [episodeId], references: [id])
    aiModel   AiModel         @relation(fields: [aiModelId], references: [id])
    createdBy User            @relation("GenerationJobCreatedBy", fields: [createdById], references: [id])
    parentJob GenerationJob?  @relation("GenerationJobRetryChain", fields: [parentJobId], references: [id])
    retries   GenerationJob[] @relation("GenerationJobRetryChain")

    generatedAssets   GeneratedAsset[]
    assembledPackages EpisodePackage[] @relation("EpisodePackageAssemblyJob")

    @@map("generation_jobs")
}
