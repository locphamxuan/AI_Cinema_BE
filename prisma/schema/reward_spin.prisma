/// What a reward spin can win (BR-09).
enum RewardPrizeType {
  /// Bonus Coins, in a lot that expires like any bonus.
  BONUS_COIN
  /// Days of the monthly plan: added to a running plan, or a plan of that many days that does not
  /// auto-renew. Their value is a promotion cost, never revenue (BR-49).
  PLAN_DAYS
}

/// One slot of the reward wheel; the Admin sets the prizes and their weights. A prize is drawn
/// with probability weight / sum of the active weights.
model RewardPrize {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(50)
  name        String          @db.VarChar(255)
  type        RewardPrizeType
  /// Set for BONUS_COIN only.
  bonusCoins  Int?            @map("bonus_coins")
  /// Set for PLAN_DAYS only.
  planDays    Int?            @map("plan_days")
  weight      Int
  isActive    Boolean         @default(true) @map("is_active")
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User         @relation("RewardPrizeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  spins     RewardSpin[]

  @@index([isActive])
  @@map("reward_prizes")
}

enum RewardSpinStatus {
  AVAILABLE
  USED
}

/// One spin a member earned on a milestone check-in (BR-09). Spinning draws a prize and keeps a
/// copy of what it paid, so a later edit of the prize does not rewrite history.
model RewardSpin {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  /// The milestone check-in that earned the spin.
  checkInId         String           @unique @map("check_in_id") @db.Uuid
  status            RewardSpinStatus @default(AVAILABLE)
  grantedAt         DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  spunAt            DateTime?        @map("spun_at") @db.Timestamptz(6)
  prizeId           String?          @map("prize_id") @db.Uuid
  prizeType         RewardPrizeType? @map("prize_type")
  bonusCoins        Int?             @map("bonus_coins")
  planDays          Int?             @map("plan_days")
  /// BR-49: plan days valued at days x monthly price / 30, a promotion cost.
  promoValueCoins   Int?             @map("promo_value_coins")
  /// The ledger entry of a BONUS_COIN prize.
  coinTransactionId String?          @unique @map("coin_transaction_id") @db.Uuid
  /// The plan a PLAN_DAYS prize extended or started.
  subscriptionId    String?          @map("subscription_id") @db.Uuid
  /// Replaying a spin with the same key answers the first result.
  idempotencyKey    String?          @unique @map("idempotency_key") @db.VarChar(100)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn         DailyCheckIn     @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  prize           RewardPrize?     @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  coinTransaction CoinTransaction? @relation(fields: [coinTransactionId], references: [id], onDelete: Restrict)
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("reward_spins")
}
