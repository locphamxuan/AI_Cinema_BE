enum PolicyType {
  AI_LABELING
  CONTENT_POLICY
  COPYRIGHT
  LEGAL
  PUBLISHING
}

/// Legal texts AI labels and compliance checks refer to, e.g. "Điều 44 Luật 134/2025/QH15".
model Policy {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(255)
  type              PolicyType
  version           String     @db.VarChar(50)
  documentReference String?    @map("document_reference") @db.Text
  content           Json?      @db.JsonB
  effectiveFrom     DateTime?  @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime?  @map("effective_to") @db.Timestamptz(6)
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  aiContentLabels  AiContentLabel[]
  complianceChecks ComplianceCheck[]

  @@map("policies")
}
