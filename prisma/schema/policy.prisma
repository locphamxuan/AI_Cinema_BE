/// Which compliance work a policy governs; each value backs specific BR-42 items (see ComplianceService).
enum PolicyType {
  /// The AI label the Reviewer applies (BR-40) and the "has an AI label" compliance item.
  AI_LABELING
  /// The content-safety compliance item.
  CONTENT_POLICY
  /// The Decree 142 notice and the real-person/real-event compliance items.
  LEGAL
}

/// The rules a Reviewer follows when labelling a version and checking its compliance, e.g. "Điều 44 Luật 134/2025/QH15".
model Policy {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(255)
  type              PolicyType
  version           String     @db.VarChar(50)
  documentReference String?    @map("document_reference") @db.Text
  /// Plain text the Reviewer reads; line breaks and "- " bullets are kept as written.
  content           String     @db.Text
  effectiveFrom     DateTime?  @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime?  @map("effective_to") @db.Timestamptz(6)
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  aiContentLabels  AiContentLabel[]
  complianceChecks ComplianceCheck[]

  @@map("policies")
}
