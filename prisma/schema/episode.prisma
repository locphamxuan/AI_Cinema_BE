//Catalog lifecycle of a released episode (or standalone film when `season_id` is NULL).
//Created/finalized AFTER production, from an approved EpisodePackage.
enum EpisodeProductionStatus {
    DRAFT
    PUBLISHED
    UNPUBLISHED
    ARCHIVED
}

model Episode {
    id               String                  @id @default(uuid()) @db.Uuid
    movieId          String                  @map("movie_id") @db.Uuid
    seasonId         String?                 @map("season_id") @db.Uuid
    episodeNumber    Int                     @map("episode_number") @db.Integer
    title            String                  @db.VarChar(255)
    productionStatus EpisodeProductionStatus @default(DRAFT) @map("production_status")
    currentPackageId String?                 @unique @map("current_package_id") @db.Uuid
    synopsis         String?                 @db.Text
    thumbnailUrl     String?                 @map("thumbnail_url") @db.VarChar(500)
    // BR-31: an episode is at most 30 minutes
    durationSeconds  Int?                    @map("duration_seconds") @db.Integer
    // BR-29: price in Coin to unlock the episode; 0 = free
    coinPrice        Int                     @default(0) @map("coin_price") @db.Integer
    // HLS playlist served to viewers; filled from the published package's video
    streamUrl        String?                 @map("stream_url") @db.VarChar(500)

    movie          Movie           @relation(fields: [movieId], references: [id])
    season         Season?         @relation(fields: [seasonId], references: [id])
    currentPackage EpisodePackage? @relation("EpisodeCurrentPackage", fields: [currentPackageId], references: [id])

    publications Publication[]

    @@unique([movieId, seasonId, episodeNumber])
    @@map("episodes")
}
