enum AdStatus {
  ACTIVE
  PAUSED
}

enum AdBreakStatus {
  SCHEDULED
  PLAYED
  SKIPPED
}

/// Mid-roll ad catalog. Schedule and impression share one SessionAdBreak row: a break moves
/// SCHEDULED -> PLAYED when the player reaches its cue, which counts the impression. The
/// separate completedView flag records a player-confirmed full view, never the start alone.
model Ad {
  id              String    @id @default(uuid()) @db.Uuid
  title           String    @db.VarChar(255)
  mediaUrl        String    @map("media_url") @db.VarChar(1000)
  clickUrl        String?   @map("click_url") @db.VarChar(1000)
  durationSeconds Int       @map("duration_seconds")
  /// Pick weight for step 13 weighted selection.
  weight          Int       @default(1)
  status          AdStatus  @default(ACTIVE)
  validFrom       DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  breaks SessionAdBreak[]
  slots  EpisodeAdSlot[]

  @@index([status])
  @@map("ads")
}
