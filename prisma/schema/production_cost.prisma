enum ProductionCostEntryType {
  /// The budget the Admin set when the project was ideated; one per project.
  BUDGET
  /// Granted by the Admin on a production cost request.
  ADDITIONAL
  /// The Admin fixes a mistake; may be negative.
  CORRECTION
}

/// Production cost of a movie in VND, append-only (BR-45, BR-46): the budget is the sum of the entries.
/// A mistake is fixed with a CORRECTION entry, never by editing a row. The studio is paid a fixed agreed fee
/// outside the platform (no revenue share); the platform only records it to work out profit and loss.
model ProductionCostEntry {
  id          String                  @id @default(uuid()) @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  entryType   ProductionCostEntryType @map("entry_type")
  /// A multiple of 1,000; negative only for CORRECTION.
  amountVnd   BigInt                  @map("amount_vnd")
  /// Required except for BUDGET.
  reason      String?                 @db.Text
  /// The request an ADDITIONAL entry grants.
  requestId   String?                 @unique @map("request_id") @db.Uuid
  createdById String                  @map("created_by_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  project   MovieProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  request   ProductionCostRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdBy User                   @relation("CostEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("production_cost_entries")
}

enum CostRequestStatus {
  OPEN
  APPROVED
  REJECTED
}

/// The Reviewer asks the Admin for more production cost, usually because the studio quoted more than the
/// budget left, with the studio's quote as proof. The Admin grants it (possibly less) or refuses with a reason.
model ProductionCostRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  /// The hand-off whose studio asked for more; null when the request is about the project as a whole.
  handoffId          String?           @map("handoff_id") @db.Uuid
  requestedById      String            @map("requested_by_id") @db.Uuid
  /// What the studio quoted, when known.
  studioQuoteVnd     BigInt?           @map("studio_quote_vnd")
  requestedVnd       BigInt            @map("requested_vnd")
  reason             String            @db.Text
  /// The proof (e.g. the studio quote); null only on rows migrated from the Token era.
  attachmentName     String?           @map("attachment_name") @db.VarChar(255)
  attachmentKey      String?           @map("attachment_key") @db.VarChar(500)
  attachmentMimeType String?           @map("attachment_mime_type") @db.VarChar(100)
  status             CostRequestStatus @default(OPEN)
  /// What the Admin granted; null until approved, never more than asked for.
  grantedVnd         BigInt?           @map("granted_vnd")
  /// Required when REJECTED.
  adminResponse      String?           @map("admin_response") @db.Text
  resolvedById       String?           @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  project     MovieProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  handoff     StudioHandoff?       @relation(fields: [handoffId], references: [id], onDelete: SetNull)
  requestedBy User                 @relation("CostRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy  User?                @relation("CostRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  entry       ProductionCostEntry?

  @@index([projectId, status])
  @@index([status, createdAt])
  @@map("production_cost_requests")
}
