enum SupportSenderType {
  MEMBER
  AI_CHATBOT
  SUPPORT_AGENT
  SYSTEM
}

/// Admin's verdict on one AI answer (AI console, 2026-11-14): NOT_HELPFUL answers show where the KB needs more.
enum SupportAiFeedback {
  HELPFUL
  NOT_HELPFUL
}

/// Every message of a support case. `isInternal` rows are Staff notes the member never sees.
/// `clientMessageId` makes a member's retry idempotent; `replyToMessageId` is unique so one
/// member message gets at most one AI reply.
model SupportMessage {
  id               String            @id @default(uuid()) @db.Uuid
  conversationId   String            @map("conversation_id") @db.Uuid
  senderType       SupportSenderType @map("sender_type")
  senderId         String?           @map("sender_id") @db.Uuid
  content          String            @db.Text
  isInternal       Boolean           @default(false) @map("is_internal")
  clientMessageId  String?           @map("client_message_id") @db.VarChar(100)
  replyToMessageId String?           @unique @map("reply_to_message_id") @db.Uuid
  aiMetadata       Json?             @map("ai_metadata") @db.JsonB
  aiFeedback       SupportAiFeedback? @map("ai_feedback")
  aiFeedbackNote   String?           @map("ai_feedback_note") @db.Text
  aiFeedbackById   String?           @map("ai_feedback_by_id") @db.Uuid
  aiFeedbackAt     DateTime?         @map("ai_feedback_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiFeedbackBy User?               @relation("SupportMessageAiFeedbackBy", fields: [aiFeedbackById], references: [id], onDelete: SetNull)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderType, createdAt])
  @@map("support_messages")
}
