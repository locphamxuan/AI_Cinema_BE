enum ComplianceCheckType {
    AI_LABEL_PRESENCE
    CONTENT_POLICY
    COPYRIGHT
    LEGAL
    // Watermark embedded in the video (docs: watermark_verified)
    WATERMARK
    // Passes only if nothing depicts a real person or event (BR-43)
    REAL_PERSON_LIKENESS
}

enum ComplianceResult {
    PENDING
    PASS
    FAIL
}

//An event verifying that the episode package complies with legal requirements (AI labeling, content policies).
model ComplianceCheck {
    id               String              @id @default(uuid()) @db.Uuid
    episodePackageId String              @map("episode_package_id") @db.Uuid
    checkType        ComplianceCheckType @map("check_type")
    result           ComplianceResult    @default(PENDING)
    checkedById      String?             @map("checked_by_id") @db.Uuid
    checkedBySystem  String?             @map("checked_by_system") @db.VarChar(100)
    failureReason    String?             @map("failure_reason") @db.Text
    checkedAt        DateTime?           @map("checked_at") @db.Timestamptz(6)
    policyId         String              @db.Uuid

    episodePackage EpisodePackage @relation(fields: [episodePackageId], references: [id])
    checkedBy      User?          @relation("ComplianceCheckedBy", fields: [checkedById], references: [id])
    policy         Policy         @relation(fields: [policyId], references: [id])

    @@map("compliance_checks")
}
