/// A Content Creator working on a project, besides or instead of the lead (BR-13). A Creator can hand
/// their share to another one: the new row points back at the delegator.
model ProjectCreatorAssignment {
    id              String    @id @default(uuid()) @db.Uuid
    projectId         String    @map("project_id") @db.Uuid
    creatorId       String    @map("creator_id") @db.Uuid
    assignedById    String    @map("assigned_by_id") @db.Uuid
    /// Set when the Creator took over from another Creator.
    delegatedFromId String?   @map("delegated_from_id") @db.Uuid
    isActive        Boolean   @default(true) @map("is_active")
    note            String?   @db.Text
    assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
    unassignedAt    DateTime? @map("unassigned_at") @db.Timestamptz(6)

    project         MovieProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
    creator       User  @relation("AssignmentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
    assignedBy    User  @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
    delegatedFrom User? @relation("AssignmentDelegatedFrom", fields: [delegatedFromId], references: [id], onDelete: SetNull)

    @@index([projectId, isActive])
    @@index([creatorId])
    @@map("project_creator_assignments")
}
