enum TokenRequestStatus {
    OPEN
    APPROVED
    REJECTED
}

/// A Creator asks the project's Reviewer for more production-fee Token, usually because the studio
/// did not accept the amount offered. Approving puts a TOP_UP entry on the season in the token ledger.
model TokenRequest {
    id               String             @id @default(uuid()) @db.Uuid
    movieId          String             @map("movie_id") @db.Uuid
    seasonId         String             @map("season_id") @db.Uuid
    requestedById    String             @map("requested_by_id") @db.Uuid
    requestedTokens  BigInt             @map("requested_tokens")
    /// Why the extra Token is needed, e.g. what the studio answered.
    reason           String             @db.Text
    status           TokenRequestStatus @default(OPEN)
    /// Token the Reviewer actually granted; null until approved.
    grantedTokens    BigInt?            @map("granted_tokens")
    /// Required when REJECTED.
    reviewerResponse String?            @map("reviewer_response") @db.Text
    resolvedById     String?            @map("resolved_by_id") @db.Uuid
    resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz(6)
    createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

    movie       Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
    season      Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
    requestedBy User   @relation("TokenRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
    resolvedBy  User?  @relation("TokenRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

    @@index([movieId, status])
    @@index([requestedById, createdAt])
    @@map("token_requests")
}