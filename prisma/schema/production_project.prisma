enum ProductionProjectStatus {
    DRAFT
    ACTIVE
    COMPLETED
    CANCELLED
}

//A single production run, encompassing the deadline and total budget quota for a group of episodes.
model ProductionProject {
    id                     String                  @id @default(uuid()) @db.Uuid
    movieId                String?                 @map("movie_id") @db.Uuid
    seasonId               String?                 @map("season_id") @db.Uuid
    createdById            String                  @map("created_by") @db.Uuid
    deadline               DateTime                @db.Timestamptz(6)
    plannedReleaseDate     DateTime                @map("planned_release_date") @db.Timestamptz(6)
    totalAiQuotaBudget     Decimal                 @map("total_ai_quota_budget") @db.Decimal
    remainingAiQuotaBudget Decimal                 @map("remaining_ai_quota_budget") @db.Decimal
    status                 ProductionProjectStatus @default(DRAFT)

    movie            Movie?            @relation(fields: [movieId], references: [id])
    season           Season?           @relation(fields: [seasonId], references: [id])
    createdBy        User              @relation("ProductionProjectCreatedBy", fields: [createdById], references: [id])
    episodes         Episode[]
    quotaAllocations QuotaAllocation[]

    @@map("production_projects")
}
