enum ProductionProjectStatus {
    DRAFT
    ACTIVE
    COMPLETED
    CANCELLED
}

enum ProductionContentType {
    MOVIE
    SERIES
}

//AI movie production workspace/plan to create a new movie or series.
//Created BEFORE any catalog content (Movie/Season/Episode) exists.
model ProductionProject {
    id                            String                  @id @default(uuid()) @db.Uuid
    title                         String                  @db.VarChar(255)
    description                   String?                 @db.Text
    contentType                   ProductionContentType   @map("content_type")
    createdById                   String                  @map("created_by") @db.Uuid
    assignedCreatorId             String                  @map("assigned_creator_id") @db.Uuid
    episodeCount                  Int?                    @map("episode_count")
    productionStartDate           DateTime                @map("production_start_date")
    deadline                      DateTime                @db.Timestamptz(6)
    plannedReleaseDate            DateTime                @map("planned_release_date") @db.Timestamptz(6)
    defaultEpisodeDurationSeconds Int?                    @map("default_episode_duration_seconds") @db.Integer
    totalAiQuotaBudget            Decimal                 @map("total_ai_quota_budget") @db.Decimal
    remainingAiQuotaBudget        Decimal                 @map("remaining_ai_quota_budget") @db.Decimal
    status                        ProductionProjectStatus @default(DRAFT)
    cancelledReason               String?                 @map("cancelled_reason") @db.Text
    // Which genre's LoRA style (see GenreStyleModel) drives visual
    // generation for this project. A project can be tagged with several
    // genres via productionProjectGenres, but exactly one — this one — is
    // the style actually applied at generation time.
    primaryGenreId                String?                 @map("primary_genre_id") @db.Uuid
    // Catalog title the project's episodes are published under; created when
    // the first episode enters the catalog and reused for every later one.
    movieId                       String?                 @unique @map("movie_id") @db.Uuid

    createdBy               User                     @relation("ProductionProjectCreatedBy", fields: [createdById], references: [id])
    assignedCreator         User                     @relation("ProductionProjectAssignedCreator", fields: [assignedCreatorId], references: [id])
    primaryGenre            Genre?                   @relation("ProductionProjectPrimaryGenre", fields: [primaryGenreId], references: [id], onDelete: SetNull)
    movie                   Movie?                   @relation(fields: [movieId], references: [id], onDelete: SetNull)
    productionPlans         ProductionPlan[]
    quotaAllocations        QuotaAllocation[]
    milestones              Milestone[]
    projectPolicies         ProjectPolicy[]
    productionProjectGenres ProductionProjectGenre[]

    @@map("production_projects")
}
