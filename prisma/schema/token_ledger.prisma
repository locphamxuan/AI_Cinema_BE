enum TokenEntryType {
  INITIAL
  TOP_UP
  CORRECTION
}

/// Production fee of a movie in Token, append-only (BR-45, BR-46, BR-50). A mistake is fixed
/// with a CORRECTION entry, never by editing a row. An entry belongs to a season when the fee is
/// priced per season: INITIAL is its baseline (price × episodes), TOP_UP the "+… Token thêm".
model TokenLedgerEntry {
  id           String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  seasonId     String?        @map("season_id") @db.Uuid
  entryType    TokenEntryType @map("entry_type")
  /// Negative only for CORRECTION.
  amountTokens BigInt         @map("amount_tokens")
  /// Token rate when the entry was written.
  rateVnd      Int            @map("rate_vnd")
  reason       String?        @db.Text
  createdById  String         @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  project     MovieProject   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  season    Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([seasonId])
  @@map("token_ledger")
}
