enum LabelType {
    AI_GENERATED
    AI_EDITED
    AI_ASSISTED
}

//AI-generated content label attached to the episode_package.
model AiContentLabel {
    id               String    @id @default(uuid()) @db.Uuid
    episodePackageId String    @map("episode_package_id") @db.Uuid
    labelType        LabelType @map("label_type")
    labelText        String    @map("label_text") @db.VarChar(500)
    displayLocation  String?   @map("display_location") @db.VarChar(100)
    appliedById      String?   @map("applied_by_id") @db.Uuid
    policyId         String    @db.Uuid

    episodePackage EpisodePackage @relation(fields: [episodePackageId], references: [id])
    appliedBy      User?          @relation("LabelAppliedBy", fields: [appliedById], references: [id])
    policy         Policy         @relation(fields: [policyId], references: [id])

    @@map("ai_content_labels")
}
