model ContentBrief {
    id                    String   @id @default(uuid()) @db.Uuid
    episodeId             String   @map("episode_id") @db.Uuid
    promptText            String   @map("prompt_text") @db.Text
    styleConfig           Json?    @map("style_config") @db.JsonB
    targetDurationSeconds Int?     @map("target_duration_seconds") @db.Integer
    targetLanguages       String[] @map("target_languages") @db.VarChar(10) // ex: ["vi", "en", "ja"]
    createdById           String   @map("created_by_id") @db.Uuid
    createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    episode   Episode @relation(fields: [episodeId], references: [id])
    createdBy User    @relation("ContentBriefCreatedBy", fields: [createdById], references: [id])

    @@map("content_briefs")
}
