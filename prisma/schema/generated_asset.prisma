enum AssetType {
    SCRIPT
    DUB_AUDIO
    BACKGROUND_AUDIO
    SUBTITLE
    POSTER
    THUMBNAIL
    VIDEO
}

enum GeneratedAssetStatus {
    GENERATED
    VALIDATION_FAILED
    REJECTED
    ACCEPTED
}

/**
 * 1 specific artifact generated by 1 job (script text, audio,
 * subtitle, poster, video...) — 1 polymorphic table replacing 7+ separate tables.
 */
model GeneratedAsset {
    id              String               @id @default(uuid()) @db.Uuid
    generationJobId String               @map("generation_job_id") @db.Uuid
    assetType       AssetType            @map("asset_type")
    language        String?              @db.VarChar(10)
    contentText     String?              @map("content_text") @db.Text
    storageKey      String?              @map("storage_key") @db.VarChar(500)
    mimeType        String?              @map("mime_type") @db.VarChar(100)
    fileSizeBytes   BigInt?              @map("file_size_bytes") @db.BigInt
    checksumSha256  String?              @map("checksum_sha256") @db.VarChar(64)
    durationSeconds Int?                 @map("duration_seconds") @db.Integer
    resolution      String?              @db.VarChar(50)
    metadata        Json?                @db.JsonB
    status          GeneratedAssetStatus @default(GENERATED)
    isSelected      Boolean              @default(false) @map("is_selected")

    generationJob GenerationJob         @relation(fields: [generationJobId], references: [id])
    packageLinks  EpisodePackageAsset[]

    @@map("generated_assets")
}
