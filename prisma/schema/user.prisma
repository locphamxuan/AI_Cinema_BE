model User {
    id           String   @id @default(uuid()) @db.Uuid
    email        String   @unique @db.VarChar(255)
    passwordHash String   @map("password_hash") @db.VarChar(255)
    fullName     String   @map("full_name") @db.VarChar(255)
    isActive     Boolean  @default(true) @map("is_active")
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    moviesCreated             Movie[]             @relation("MovieCreatedBy")
    productionPlansCreated    ProductionPlan[]    @relation("ProductionPlanCreatedBy")
    generationJobs            GenerationJob[]     @relation("GenerationJobCreatedBy")
    reviews                   Review[]            @relation("ReviewReviewer")
    complianceChecks          ComplianceCheck[]   @relation("ComplianceCheckedBy")
    appliedLabels             AiContentLabel[]    @relation("LabelAppliedBy")
    publications              Publication[]       @relation("PublicationPublishedBy")
    planReviews               PlanReview[]        @relation("PlanReviewReviewer")
    quotaAllocationsCreated   QuotaAllocation[]   @relation("QuotaAllocationCreatedBy")
    productionProjectsCreated ProductionProject[] @relation("ProductionProjectCreatedBy")
    submissions               Submission[]        @relation("SubmissionSubmittedBy")
    productionProjects        ProductionProject[] @relation("ProductionProjectAssignedCreator")
    userRoles                 UserRole[]

    @@map("users")
}
