enum UserRole {
  MEMBER
  CONTENT_CREATOR
  CONTENT_REVIEWER
  STAFF
  ADMIN
  /// MF-1 (07/11/2026): a partner studio's login, tied to one `studios` row (studio_id).
  STUDIO
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(255)
  /// BR-54: required for members, who must be 18 or older; staff accounts may leave it empty.
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  phoneNumber     String?   @map("phone_number") @db.VarChar(20)
  role            UserRole  @default(MEMBER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  /// Set on STUDIO accounts only: the studio the account speaks for.
  studioId        String?   @map("studio_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  studio                  Studio?                    @relation("StudioAccounts", fields: [studioId], references: [id], onDelete: Restrict)
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  platformSettingsUpdated PlatformSetting[]
  projectsReviewed        MovieProject[]             @relation("ProjectReviewer")
  projectsCreated         MovieProject[]             @relation("ProjectCreator")
  assignmentsAsCreator    ProjectCreatorAssignment[] @relation("AssignmentCreator")
  assignmentsMade         ProjectCreatorAssignment[] @relation("AssignmentAssignedBy")
  assignmentsDelegated    ProjectCreatorAssignment[] @relation("AssignmentDelegatedFrom")
  episodesAssigned        Episode[]                  @relation("EpisodeAssignedCreator")
  ideaFilesUploaded       MovieIdeaFile[]
  studioHandoffs          StudioHandoff[]
  studiosCreated          Studio[]
  handoffMaterials        StudioHandoffMaterial[]    @relation("HandoffMaterialUploadedBy")
  milestoneChanges        StudioMilestoneEvent[]     @relation("MilestoneChangedBy")
  changeRequestsMade      ProjectChangeRequest[]     @relation("ChangeRequestRequestedBy")
  changeRequestsResolved  ProjectChangeRequest[]     @relation("ChangeRequestResolvedBy")
  contractsCreated        Contract[]                 @relation("ContractCreatedBy")
  contractsSignedAsAdmin  Contract[]                 @relation("ContractAdminSignedBy")
  costRequestsMade        ProductionCostRequest[]    @relation("CostRequestRequestedBy")
  costRequestsResolved    ProductionCostRequest[]    @relation("CostRequestResolvedBy")
  movieLikes              MovieLike[]
  savedMovies             SavedMovie[]
  episodeViews            EpisodeView[]
  costEntries             ProductionCostEntry[]      @relation("CostEntryCreatedBy")
  mediaSubmitted          MediaAsset[]
  contentReviews          ContentReview[]
  labelsApplied           AiContentLabel[]
  complianceChecked       ComplianceCheck[]
  publicationsPublished   Publication[]              @relation("PublicationPublishedBy")
  publicationsUnpublished Publication[]              @relation("PublicationUnpublishedBy")
  priceAlertsSet          PriceAlert[]               @relation("PriceAlertSetBy")
  priceAlertsHandled      PriceAlert[]               @relation("PriceAlertHandledBy")
  notifications           Notification[]
  coinWallet              CoinWallet?
  coinEntriesWritten      CoinTransaction[]          @relation("CoinTransactionCreatedBy")
  coinTopUps              CoinTopUp[]
  dailyCheckIns           DailyCheckIn[]
  membershipPlansCreated  MembershipPlan[]           @relation("MembershipPlanCreatedBy")
  planPricesSet           MembershipPlanPrice[]      @relation("MembershipPlanPriceSetBy")
  rewardRulesCreated      RewardRule[]               @relation("RewardRuleCreatedBy")
  subscriptions           Subscription[]
  episodeAccesses         EpisodeAccess[]
  rewardSpins             RewardSpin[]
  rewardPrizesCreated     RewardPrize[]              @relation("RewardPrizeCreatedBy")
  payments                Payment[]
  streamingSessions       StreamingSession[]
  devices                 UserDevice[]
  watchProgresses         WatchProgress[]
  episodeAdSlotsCreated   EpisodeAdSlot[]            @relation("EpisodeAdSlotCreatedBy")
  scriptVersionsSubmitted ScriptVersion[]            @relation("ScriptVersionSubmittedBy")
  scriptReviews           ScriptReview[]             @relation("ScriptReviewer")
  episodesFinalConfirmed  Episode[]                  @relation("EpisodeFinalConfirmedBy")
  passwordResetOtps       PasswordResetOtp[]

  @@index([role])
  @@index([studioId])
  @@map("users")
}
