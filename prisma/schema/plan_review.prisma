enum PlanReviewStatus {
    PENDING
    IN_REVIEW
    APPROVED
    REJECTED
    CHANGES_REQUESTED
}

//Dedicated review round for production_plan
//One review cycle by a Content Reviewer for a specific production plan.
// BR-39: a plan review round has one row per scene plus one per plan-level field.
enum PlanReviewField {
    SCENE
    OVERALL_SCRIPT
    DURATION
    TOKEN_ESTIMATE
}

model PlanReview {
    id               String           @id @default(uuid()) @db.Uuid
    productionPlanId String           @map("production_plan_id") @db.Uuid
    reviewerId       String           @map("reviewer_id") @db.Uuid
    status           PlanReviewStatus @default(PENDING)
    // sceneId is set only when field = SCENE
    field            PlanReviewField  @default(SCENE)
    comments         String?          @db.Text
    rejectionReason  String?          @map("rejection_reason") @db.Text
    decidedAt        DateTime?        @map("decided_at") @db.Timestamptz(6)
    createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    sceneId          String?          @db.Uuid

    productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id])
    reviewer       User           @relation("PlanReviewReviewer", fields: [reviewerId], references: [id])
    scene          Scene?         @relation(fields: [sceneId], references: [id])

    @@map("plan_reviews")
}
