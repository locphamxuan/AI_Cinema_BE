enum UnpublishReason {
  MANUAL
  COMPLIANCE_ISSUE
  BROKEN_SOURCE
}

enum PriceAlertStatus {
  OPEN
  CHANGE_REQUESTED
  RESOLVED
}

/// Publishing of one episode with the reviewed media version (BR-14, BR-19).
model Publication {
  id              String           @id @default(uuid()) @db.Uuid
  episodeId       String           @map("episode_id") @db.Uuid
  /// = episodes.approved_media_asset_id when it was scheduled.
  mediaAssetId    String           @map("media_asset_id") @db.Uuid
  scheduledAt     DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(6)
  unpublishedAt   DateTime?        @map("unpublished_at") @db.Timestamptz(6)
  unpublishReason UnpublishReason? @map("unpublish_reason")
  unpublishNote   String?          @map("unpublish_note") @db.Text
  publishedById   String           @map("published_by_id") @db.Uuid
  unpublishedById String?          @map("unpublished_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  episode       Episode    @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  mediaAsset    MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  publishedBy   User       @relation("PublicationPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  unpublishedBy User?      @relation("PublicationUnpublishedBy", fields: [unpublishedById], references: [id], onDelete: SetNull)

  @@index([episodeId])
  @@index([scheduledAt])
  @@map("publications")
}

/// A Coin price outside the range the Admin configured (BR-47). The price is kept; the Admin is told.
model PriceAlert {
  id          String           @id @default(uuid()) @db.Uuid
  episodeId   String           @map("episode_id") @db.Uuid
  coinPrice   Int              @map("coin_price")
  /// The valid range when the price was set.
  rangeMin    Int              @map("range_min")
  rangeMax    Int              @map("range_max")
  setById     String           @map("set_by_id") @db.Uuid
  status      PriceAlertStatus @default(OPEN)
  /// Note the Admin sends the Reviewer with a change request.
  adminNote   String?          @map("admin_note") @db.Text
  handledById String?          @map("handled_by_id") @db.Uuid
  handledAt   DateTime?        @map("handled_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  setBy     User    @relation("PriceAlertSetBy", fields: [setById], references: [id], onDelete: Restrict)
  handledBy User?   @relation("PriceAlertHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([episodeId])
  @@map("price_alerts")
}
