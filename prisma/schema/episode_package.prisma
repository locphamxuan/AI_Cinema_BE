enum EpisodePackageStatus {
    ASSEMBLED
    SUPERSEDED
}

//A specific bundle comprising the selected assets, forming a complete "release candidate".
//Assembled from a ProductionPlan's generated assets, before any catalog Episode exists.
model EpisodePackage {
    id               String               @id @default(uuid()) @db.Uuid
    productionPlanId String               @map("production_plan_id") @db.Uuid
    packageVersion   Int                  @map("package_version") @db.Integer
    assembledBy      String?              @map("assembled_by") @db.Uuid
    assemblyJobId    String?              @map("assembly_job_id") @db.Uuid
    status           EpisodePackageStatus @default(ASSEMBLED)
    createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

    productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id])
    assemblyJob    GenerationJob? @relation("EpisodePackageAssemblyJob", fields: [assemblyJobId], references: [id])

    currentForEpisode Episode? @relation("EpisodeCurrentPackage")

    assets           EpisodePackageAsset[]
    reviews          Review[]
    complianceChecks ComplianceCheck[]
    aiContentLabels  AiContentLabel[]
    publications     Publication[]
    submissions      Submission[]

    @@unique([productionPlanId, packageVersion])
    @@map("episode_packages")
}
