enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Outgoing email: only OTP codes and the studio brief (BR-53).
model EmailMessage {
  id             String      @id @default(uuid()) @db.Uuid
  toEmail        String      @map("to_email") @db.VarChar(255)
  /// STUDIO_BRIEF / OTP
  template       String      @db.VarChar(100)
  subject        String      @db.VarChar(255)
  payload        Json?       @db.JsonB
  attachmentKeys String[]    @default([]) @map("attachment_keys")
  status         EmailStatus @default(QUEUED)
  attempts       Int         @default(0)
  errorMessage   String?     @map("error_message") @db.Text
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  studioHandoffs StudioHandoff[]

  @@index([status])
  @@map("email_messages")
}

/// In-app notification (S7 Notification Service): every internal alert goes here, not by email (BR-53).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  /// Screen the notification opens.
  link      String?   @db.VarChar(500)
  payload   Json?     @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
