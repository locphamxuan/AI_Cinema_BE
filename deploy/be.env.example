# Copy to be.env on the VPS and fill every <...>. Never commit be.env.
NODE_ENV=production
PORT=3001
TRUST_PROXY=true
SWAGGER_ENABLED=false

# Neon (pooled URL for the app, direct URL for migrations)
DATABASE_URL=<neon pooled connection string>
DIRECT_DATABASE_URL=<neon direct connection string>

# Public addresses
WEB_APP_URL=https://ai-cinema.vn
API_PUBLIC_URL=https://api.ai-cinema.vn
CORS_ORIGINS=https://ai-cinema.vn,https://www.ai-cinema.vn

# Secrets: generate each with `openssl rand -hex 48`
JWT_SECRET=<random>
PLAYBACK_URL_SECRET=<random>
STUDIO_WEBHOOK_TOKEN=<random>
SEED_USER_PASSWORD=<strong password for newly seeded accounts>

# Media on the VPS disk (volume media-storage), served by the API
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_BASE_URL=https://api.ai-cinema.vn/media
MEDIA_PIPELINE=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Google Sign-In (same Web client id as the FE)
GOOGLE_WEB_CLIENT_ID=<...>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# VNPay (sandbox until the merchant account goes live)
VNPAY_TMN_CODE=<...>
VNPAY_HASH_SECRET=<...>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://api.ai-cinema.vn/api/payments/vnpay/return
VNPAY_IPN_URL=https://api.ai-cinema.vn/api/payments/vnpay/callback

# Mail (Gmail app password or another SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<...>
SMTP_PASSWORD=<...>
MAIL_FROM="AI Cinema <no-reply@ai-cinema.vn>"
