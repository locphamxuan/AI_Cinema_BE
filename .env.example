DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=3001
CORS_ORIGINS="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Root folder of Genre Style LoRA datasets (see training-data/README.md)
TRAINING_DATA_ROOT="training-data"

# Password of every seeded staff account (creator01..08, reviewer01..06, admin) - development only
SEED_USER_PASSWORD="Aicinema@123"

# Throwaway database of the e2e suite (docker-compose.test.yml); must be local
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/ai_cinema_e2e"

# --- AI generation (see docs/ai-providers.md) ---
# "mock" (default) never calls a paid API. "live" calls the real API of every provider whose key is set below;
# providers without a key keep using the mock.
AI_PROVIDER_MODE="mock"
OPENAI_API_KEY=""        # script, subtitles (gpt-4o-mini)
FAL_KEY=""               # scene images, posters, thumbnails (FLUX.1 dev)
ELEVENLABS_API_KEY=""    # voice-over and background music - needs media storage
ELEVENLABS_VOICE_ID=""   # optional, defaults to the stock "George" voice
GEMINI_API_KEY=""        # scene video (Veo 3) - needs media storage
VEO_MODEL=""             # optional, defaults to veo-3.0-fast-generate-001

# S3-compatible bucket for generated audio/video (Cloudflare R2, Supabase Storage, AWS S3)
S3_ENDPOINT=""           # e.g. https://<account-id>.r2.cloudflarestorage.com - empty for AWS S3
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""    # public URL of the bucket, e.g. https://pub-xxxx.r2.dev
