# Copy to .env. Every value is checked when the API starts (src/config/app-config.ts).
NODE_ENV="development"
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/ai_cinema"
# Prisma CLI only (migrate, seed): the direct host when DATABASE_URL goes through a pooler (Neon: the host
# without `-pooler`). Leave empty for a local database.
DIRECT_DATABASE_URL=""
# Comma-separated origins allowed to call the API (web app on 3000, Expo web on 8081).
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
# Web app origin used in emailed links (studio portal)
WEB_APP_URL="http://localhost:3000"
# Swagger UI on /api/docs; off by default when NODE_ENV=production
SWAGGER_ENABLED=""
# true when the API runs behind a reverse proxy (client IPs for rate limiting)
TRUST_PROXY="false"

# --- Auth ---
# At least 32 random characters in production: `openssl rand -base64 48`
JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER="ai-cinema-api"
JWT_AUDIENCE="ai-cinema"
# Requests per client per window; the auth endpoints have their own, stricter limit
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
# MF-3: CGNAT puts many viewers behind one IP. Session creation stays tight (mass guest
# minting), the heartbeat gets its own budget: ~6 req/min per viewer.
RATE_LIMIT_PLAYBACK_SESSION_MAX=60
RATE_LIMIT_PLAYBACK_HEARTBEAT_MAX=1200

# Password of every seeded account (creator01..08, reviewer01..06, staff01, admin, member01) - development only
SEED_USER_PASSWORD="Aicinema@123"

# --- Storage: idea files, briefs, uploaded videos and their HLS renditions ---
# "local" keeps files under STORAGE_LOCAL_ROOT and serves the public ones on /media;
# "s3" uses an S3-compatible bucket (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER="s3"
STORAGE_LOCAL_ROOT="storage"
# Public URL players load HLS from; defaults to http://localhost:$PORT/media with the local driver.
# With R2 this is the bucket's public domain, e.g. https://pub-xxxx.r2.dev
STORAGE_PUBLIC_BASE_URL=""
S3_ENDPOINT=""           # e.g. https://<account-id>.r2.cloudflarestorage.com - empty for AWS S3
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL of the bucket; read by the AI_Film scripts (npm run film:catalog) to build the catalog links
S3_PUBLIC_BASE_URL=""

# --- Email: only OTP codes and studio briefs (BR-53). Empty SMTP_HOST = log instead of sending ---
SMTP_HOST=""             # Mailtrap sandbox: sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AI Cinema <no-reply@aicinema.local>"
# TrueType font with Vietnamese glyphs for the brief PDF (the Docker image ships DejaVu Sans)
BRIEF_FONT_PATH=""
# Shared with the Studio Web (STUDIO_WEBHOOK_TOKEN there); empty keeps POST /api/studio-inbound/film-sent closed
STUDIO_WEBHOOK_TOKEN=""

# --- Media pipeline ---
# "ffmpeg" transcodes uploads to HLS 360p/720p/1080p and probes HLS links; "mock" skips both (tests)
MEDIA_PIPELINE="ffmpeg"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
MEDIA_MAX_UPLOAD_MB=2048
MEDIA_MAX_DOWNLOAD_MB=4096
MEDIA_CONCURRENCY=1
# Lets import / HLS URLs point at localhost or a private network - local development only
MEDIA_ALLOW_PRIVATE_URLS="false"

# --- Background work ---
# Redis for the BullMQ queues and schedules. Empty = jobs run inside the request and
# schedules use in-process timers (single instance only).
# docker compose sets it for the api container; locally: `docker compose up -d redis` + redis://127.0.0.1:63790
REDIS_URL=""
# How often (ms) scheduled episodes are published, overdue episodes flagged and external HLS links checked; 0 = off
PUBLICATION_SWEEP_MS=30000
OVERDUE_SWEEP_MS=3600000
HLS_CHECK_MS=21600000
# MF-2: plan auto-renew, expired bonus lots, top-up orders nobody paid and gateway reconciliation; 0 = off
SUBSCRIPTION_RENEWAL_SWEEP_MS=60000
COIN_EXPIRY_SWEEP_MS=86400000
COIN_TOPUP_SWEEP_MS=300000
PAYMENT_RECONCILE_SWEEP_MS=600000

# Empty credentials = provider disabled; choosing it answers 422 PROVIDER_NOT_CONFIGURED.
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_CREATE_URL="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_STATUS_URL="https://test-payment.momo.vn/v2/gateway/api/transaction-status"
MOMO_REDIRECT_URL=""
MOMO_IPN_URL=""
MOMO_REQUEST_TYPE="payWithMethod"

# VNPay sandbox creds come from https://sandbox.vnpayment.vn (TMN code + Hash Secret).
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL=""
VNPAY_IPN_URL=""
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# --- Playback (MF-3 phase 2): signed HLS URLs verified by workers/playback-cdn ---
# Public base players resolve playlist URLs against; defaults to http://localhost:$PORT
API_PUBLIC_URL=""
# Empty = signing disabled (direct stream URLs, local dev). Must equal the Worker's PLAYBACK_URL_SECRET in prod.
PLAYBACK_URL_SECRET=""
# Signed URL lifetime: playlist responses re-sign child URLs, so this bounds a leaked link.
PLAYBACK_URL_TTL_SECONDS=3600
# How often (ms) timed-out streaming sessions are closed; 0 = off
STREAMING_SESSION_SWEEP_MS=30000
# Retention: finished (ENDED) sessions older than this many days are deleted,
# ad-break rows included; 0 = keep every row forever. Keep it beyond the reporting window
# (monthly revenue sharing reads session rows).
STREAMING_SESSION_RETENTION_DAYS=90
# How often (ms) the retention sweep above runs; 0 = off
STREAMING_SESSION_RETENTION_SWEEP_MS=86400000

# Throwaway database of the e2e suite (docker-compose.test.yml); must be local
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/ai_cinema_e2e"
