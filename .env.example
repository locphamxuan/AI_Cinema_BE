DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=3001
CORS_ORIGINS="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Root folder of Genre Style LoRA datasets (see training-data/README.md)
TRAINING_DATA_ROOT="training-data"

# Password of every seeded staff account (creator01..08, reviewer01..06, admin) - development only
SEED_USER_PASSWORD="Aicinema@123"

# Throwaway database of the e2e suite (docker-compose.test.yml); must be local
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/ai_cinema_e2e"

# --- AI generation (see docs/ai-providers.md) ---
# Only free tiers are wired in: no key here can ever cost money.
# "mock" (default) calls nothing. "live" calls the free service of every key set below;
# the rest, and any job over its free quota, use the sample library (mock).
AI_PROVIDER_MODE="mock"
GEMINI_API_KEY=""        # script, subtitles, voice-over — https://aistudio.google.com/apikey (project WITHOUT billing)
HF_TOKEN=""              # images (Stable Diffusion 3) and video (LTX-Video Space) — https://huggingface.co/settings/tokens (Read)
HF_VIDEO_SECONDS=""      # optional, clip length 1-8s, defaults to 4 (longer clips use more of the daily free GPU time)

# S3-compatible bucket for generated voice-over, images and video (Cloudflare R2 free tier: 10GB)
S3_ENDPOINT=""           # e.g. https://<account-id>.r2.cloudflarestorage.com - empty for AWS S3
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""    # public URL of the bucket, e.g. https://pub-xxxx.r2.dev
