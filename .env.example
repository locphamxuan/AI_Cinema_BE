# Copy thành .env (đã bị .gitignore) rồi điền connection string thật.
# Dùng chung 1 project Postgres (Neon/Supabase/Railway...) cho toàn team — mỗi người copy
# đúng 1 connection string này vào .env của máy mình, KHÔNG commit .env lên git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
