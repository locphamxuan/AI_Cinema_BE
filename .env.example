DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=3001
CORS_ORIGINS="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Root folder of Genre Style LoRA datasets (see training-data/README.md)
TRAINING_DATA_ROOT="training-data"

# Password of every seeded staff account (creator01..08, reviewer01..06, admin) - development only
SEED_USER_PASSWORD="Aicinema@123"

# Throwaway database of the e2e suite (docker-compose.test.yml); must be local
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/ai_cinema_e2e"
